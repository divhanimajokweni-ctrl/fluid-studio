<script>
(function() {
  'use strict';

  /* ---------- WAVEFORM ---------- */
  const waveformEl = document.getElementById('waveform');
  const BAR_COUNT = 72;
  const colors = ['#C47A2A', '#E8D56B', '#6A8A4F'];
  for (let i = 0; i < BAR_COUNT; i++) {
    const bar = document.createElement('div');
    bar.className = 'wave-bar';
    const center = BAR_COUNT / 2;
    const dist = Math.abs(i - center) / center;
    const envelope = 1 - Math.pow(dist, 1.8);
    const noise = 0.5 + Math.random() * 0.5;
    const height = Math.max(4, envelope * noise * 70);
    const r = Math.random();
    let color;
    if (r < 0.55) color = colors[0];
    else if (r < 0.85) color = colors[1];
    else color = colors[2];
    bar.style.height = height + '%';
    bar.style.background = color;
    bar.style.opacity = 0.55 + Math.random() * 0.45;
    waveformEl.appendChild(bar);
  }

  /* ---------- BOOT SEQUENCE ---------- */
  const boot = document.getElementById('boot');
  const bootSvg = document.getElementById('boot-svg');
  const rotor = document.getElementById('rotor');
  const centralText = document.getElementById('central-text');
  const ringMoss = document.getElementById('ring-moss');
  const ringOchre = document.getElementById('ring-ochre');
  const ringYellow = document.getElementById('ring-yellow');
  const dot1 = document.getElementById('dot-1');
  const dot2 = document.getElementById('dot-2');
  const phaseLabel = document.getElementById('phase-label');
  const timerText = document.getElementById('boot-timer');
  const nav = document.getElementById('nav');
  const main = document.getElementById('main');
  const skipBtn = document.getElementById('skip');
  const replayBtn = document.getElementById('replay');

  const BASE_INK = '#E8E6E0';
  const COLOR_MOSS = '#6A8A4F';
  const COLOR_OCHRE = '#C47A2A';
  const COLOR_YELLOW = '#E8D56B';

  const T1 = 2.0, T2 = 5.0, T3 = 7.0;

  // Ring translations in the rotor's rotated frame.
  // With rotor at 840deg (=120deg visual), these produce the correct
  // world-space Borromean positions: moss left, yellow right, ochre top.
  // (Computed by R(-120) applied to the intended world offsets.)
  const RING_OFFSETS = {
    moss:   { x:  68.37, y:  34.42 },
    yellow: { x:   4.37, y: -76.42 },
    ochre:  { x: -38.10, y:  22.00 }
  };

  function hexToRgb(hex) {
    const h = hex.replace('#', '');
    return {
      r: parseInt(h.slice(0, 2), 16),
      g: parseInt(h.slice(2, 4), 16),
      b: parseInt(h.slice(4, 6), 16)
    };
  }
  function mixColor(a, b, t) {
    const ca = hexToRgb(a), cb = hexToRgb(b);
    return `rgb(${Math.round(ca.r + (cb.r - ca.r) * t)},${Math.round(ca.g + (cb.g - ca.g) * t)},${Math.round(ca.b + (cb.b - ca.b) * t)})`;
  }
  const easeInCubic = t => t * t * t;
  const easeOutCubic = t => 1 - Math.pow(1 - t, 3);

  function setRingStroke(el, color) {
    const c = el.querySelector('circle');
    if (c) c.setAttribute('stroke', color);
  }

  let startTime = 0;
  let rafId = null;
  let finished = false;

  function render(t) {
    let rot = 0, scale = 1, blur = 0, glow = 0;
    let textOpacity = 1, split = 0;
    let label = 'INITIALIZING', labelColor = COLOR_MOSS;

    if (t < T1) {
      rot = (t / T1) * 120;
      label = 'SPIN 0.3×';
    } else if (t < T2) {
      const p = (t - T1) / (T2 - T1);
      const e = easeInCubic(p);
      rot = 120 + e * 720;
      scale = 1 + e * 0.08;
      blur = e * 14;
      glow = e;
      label = 'CRESCENDO';
      labelColor = COLOR_OCHRE;
    } else if (t < T3) {
      const p = (t - T2) / (T3 - T2);
      const e = easeOutCubic(p);
      rot = 840;
      scale = 1.08;
      blur = 14 * (1 - e);
      glow = 1 - e;
      textOpacity = 1 - e;
      split = e;
      label = 'SPLIT / BORROMEAN';
      labelColor = COLOR_YELLOW;

      ringMoss.style.transform   = `translate(${RING_OFFSETS.moss.x   * e}px, ${RING_OFFSETS.moss.y   * e}px)`;
      ringYellow.style.transform = `translate(${RING_OFFSETS.yellow.x * e}px, ${RING_OFFSETS.yellow.y * e}px)`;
      ringOchre.style.transform  = `translate(${RING_OFFSETS.ochre.x  * e}px, ${RING_OFFSETS.ochre.y  * e}px)`;

      setRingStroke(ringMoss,   mixColor(BASE_INK, COLOR_MOSS,   e));
      setRingStroke(ringYellow, mixColor(BASE_INK, COLOR_YELLOW, e));
      setRingStroke(ringOchre,  mixColor(BASE_INK, COLOR_OCHRE,  e));

      const dotOp = Math.max(0, (e - 0.5) * 2);
      dot1.setAttribute('opacity', dotOp);
      dot2.setAttribute('opacity', dotOp * 0.4);
    } else {
      rot = 840; scale = 1.08; textOpacity = 0; split = 1;
      label = 'VERIFIED'; labelColor = COLOR_YELLOW;
      ringMoss.style.transform   = `translate(${RING_OFFSETS.moss.x}px, ${RING_OFFSETS.moss.y}px)`;
      ringYellow.style.transform = `translate(${RING_OFFSETS.yellow.x}px, ${RING_OFFSETS.yellow.y}px)`;
      ringOchre.style.transform  = `translate(${RING_OFFSETS.ochre.x}px, ${RING_OFFSETS.ochre.y}px)`;
      setRingStroke(ringMoss, COLOR_MOSS);
      setRingStroke(ringYellow, COLOR_YELLOW);
      setRingStroke(ringOchre, COLOR_OCHRE);
      dot1.setAttribute('opacity', 1);
      dot2.setAttribute('opacity', 0.4);
    }

    rotor.style.transform = `rotate(${rot}deg) scale(${scale})`;
    centralText.style.opacity = textOpacity;

    const filters = [];
    if (blur > 0.05) filters.push(`blur(${blur.toFixed(2)}px)`);
    if (glow > 0.05) filters.push(`drop-shadow(0 0 ${(glow * 20).toFixed(1)}px rgba(232,230,224,${(glow * 0.4).toFixed(2)}))`);
    bootSvg.style.filter = filters.join(' ') || 'none';

    phaseLabel.innerHTML = `<span class="status-dot" style="background:${labelColor}"></span>${label}`;
    timerText.textContent = `${Math.min(t, 7).toFixed(1)}s / 7.0s`;
  }

  function loop(now) {
    if (finished) return;
    if (!startTime) startTime = now;
    const t = (now - startTime) / 1000;
    if (t >= T3) { render(T3); finish(); return; }
    render(t);
    rafId = requestAnimationFrame(loop);
  }

  function finish() {
    if (finished) return;
    finished = true;
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    boot.classList.add('done');
    nav.classList.add('show');
    main.classList.add('show');
    document.body.classList.remove('booting');
  }

  function resetAndStart() {
    finished = false;
    startTime = 0;
    // Reset visual state
    rotor.style.transform = 'rotate(0deg) scale(1)';
    centralText.style.opacity = '1';
    ringMoss.style.transform = 'none';
    ringYellow.style.transform = 'none';
    ringOchre.style.transform = 'none';
    setRingStroke(ringMoss, BASE_INK);
    setRingStroke(ringYellow, BASE_INK);
    setRingStroke(ringOchre, BASE_INK);
    dot1.setAttribute('opacity', 0);
    dot2.setAttribute('opacity', 0);
    bootSvg.style.filter = 'none';
    phaseLabel.innerHTML = '<span class="status-dot"></span>INITIALIZING';
    timerText.textContent = '0.0s / 7.0s';

    boot.classList.remove('done');
    nav.classList.remove('show');
    main.classList.remove('show');
    document.body.classList.add('booting');

    rafId = requestAnimationFrame(loop);
  }

  skipBtn.addEventListener('click', finish);
  replayBtn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'instant' in window ? 'instant' : 'auto' });
    resetAndStart();
  });

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prefersReducedMotion) {
    finish();
  } else if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => setTimeout(() => { rafId = requestAnimationFrame(loop); }, 200));
  } else {
    setTimeout(() => { rafId = requestAnimationFrame(loop); }, 200);
  }
})();
</script>

</body>
</html>
```

### Key implementation notes

**Animation timeline (single RAF loop, no CSS keyframe swaps):**

| Time | Phase | Rotor | Blur | Scale | Rings | Text |
|------|-------|-------|------|-------|-------|------|
| 0–2s | SPIN 0.3× | 0°→120° | 0 | 1.0 | centered | visible |
| 2–5s | CRESCENDO | 120°→840° (ease-in cubic) | 0→14px | 1→1.08 | centered | visible |
| 5–7s | SPLIT | frozen 840° | 14→0px | 1.08 | translate to Borromean | fade out |
| ≥7s | VERIFIED | 840° | 0 | 1.08 | settled | hidden |

**Borromean math fix:** With the rotor visually at 120° (840° mod 360°), naïve ring offsets `(-64, 42)`, `(64, 42)`, `(0, -44)` would land the rings in the *wrong* positions (moss on top, ochre bottom-right). I pre-rotated those offsets by −120° into the local frame (`(68.37, 34.42)`, `(4.37, -76.42)`, `(-38.10, 22.00)`), so the world-space result matches the cover-photo arrangement exactly.

**Skip & replay:** The `SKIP ↦` button fast-forwards to the finished state, and the subtle `↻ Replay seal` in the footer resets and re-runs the whole sequence.